# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env git'e girmez.

# Hesap şifrelerini şifreleyen anahtar (64 hex karakter). Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Boş bırakılırsa data/secret.key dosyası otomatik üretilip kullanılır.
APP_SECRET_KEY=

# Kişisel Outlook gönderimi için Azure uygulama kaydının "Uygulama (istemci) kimliği".
# Boş bırakılırsa Ayarlar ekranından girilebilir.
OUTLOOK_CLIENT_ID=
