{
  "name": "mail-templater",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:migrate && concurrently -k -n web,worker -c blue,magenta \"next dev\" \"tsx watch --clear-screen=false worker/index.ts\"",
    "dev:web": "next dev",
    "worker": "tsx worker/index.ts",
    "build": "next build",
    "start": "npm run db:migrate && concurrently -k -n web,worker \"next start\" \"tsx worker/index.ts\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "analyze": "tsx scripts/analyze.ts",
    "test:campaign": "node --env-file=scripts/test.env --import tsx scripts/test-campaign.ts",
    "test:findings": "tsx scripts/test-findings.ts",
    "test:discovery": "tsx scripts/test-discovery.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "imapflow": "^2.12.2",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
